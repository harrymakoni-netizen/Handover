# ---- Engine-free core test harness (tools/) ------------------------------
# These project files are hand-written and must be tracked, unlike Unity's
# generated *.csproj above.
!/tools/**/*.csproj
/tools/**/bin/
/tools/**/obj/
/tools/**/TestResults/

# ---- Local secrets -----------------------------------------------------------
# Keystores and credentials never enter source control.
*.keystore
*.jks
.env
